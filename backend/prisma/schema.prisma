datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String   @unique
  createdAt DateTime @default(now())

  // Auth
  passwordHash String? // ⬅ nullable now (Google users won’t have one)
  googleId     String? @unique
  avatarUrl    String?
  profileImageUrl String?
  hasCompletedOnboarding Boolean @default(false)
  isDeactivated           Boolean @default(false)
  // Email verification
  isVerified                Boolean   @default(false)
  emailVerificationToken    String?
  emailVerificationExpires  DateTime?
  // Relations
  wallet            Wallet?
  profile           Profile?
  playerGames       PlayerGame[]
  hostedMatches     Match[]           @relation("HostedMatches")
  joinedMatches     Match[]           @relation("JoinedMatches")
  role              Role              @default(PLAYER)
  sentMessages      Message[]         @relation("SentMessages")
  receivedMessages  Message[]         @relation("ReceivedMessages")
  tournamentEntries    TournamentEntry[]
  hostedTournaments    Tournament[]      @relation("TournamentHost")
  matchSubmissions     TournamentMatchSubmission[]
  teamMemberships   TeamMember[]
  ownedTeams        Team[]            @relation("TeamOwner")
  teamPosts         TeamPost[]
  sentTeamInvites   TeamInvite[]      @relation("TeamInviteSender")
  receivedTeamInvites TeamInvite[]    @relation("TeamInviteReceiver")
  raisedDisputes    Dispute[]
  bans              Ban[]             @relation("UserBans")
  moderatedBans     Ban[]             @relation("ModeratorBans")
  friends           Friend[]          @relation("UserFriends")
  friendOf          Friend[]          @relation("UserFriendOf")
  sentFriendRequests FriendRequest[]  @relation("SentFriendRequests")
  receivedFriendRequests FriendRequest[] @relation("ReceivedFriendRequests")
  blockedUsers      BlockedUser[]     @relation("BlockedByUser")
  blockedByUsers    BlockedUser[]     @relation("BlockedTargetUser")
  dmConversationsAsFirst Conversation[] @relation("ConversationFirstUser")
  dmConversationsAsSecond Conversation[] @relation("ConversationSecondUser")
  playerLogs        PlayerLog[]
  escrows           Escrow[]
  bugReports        BugReport[]
}

model Profile {
  id           String    @id @default(uuid())
  userId       String    @unique
  displayName  String?
  bio          String?
  country      String?
  region       String?
  continent    String?
  level        Int       @default(1)
  trustScore   Float     @default(100)
  manualStatus String?   // "dnd" | null — stored only when user manually sets it
  lastSeen     DateTime? // updated on socket disconnect

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PlayerGame {
  id        String  @id @default(uuid())
  userId    String
  game      String
  wins      Int     @default(0)
  losses    Int     @default(0)
  hours     Int     @default(0)
  isPrimary Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, game])
}

model Wallet {
  id     String @id @default(uuid())
  userId String @unique

  balance Int @default(0)
  escrow  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledger LedgerEntry[]
}

model LedgerEntry {
  id        String   @id @default(uuid())
  walletId  String

  type      String   // deposit | withdrawal | escrow_lock | payout | refund
  amount    Int      // in cents

  matchId      String?
  tournamentId String?

  stripePaymentIntentId String?

  createdAt DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
}

model Escrow {
  id        String @id @default(uuid())

  matchId       String?
  tournamentId  String?
  userId        String

  amount    Int
  status    String // locked | released | refunded

  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
}

model Match {
  id        String   @id @default(uuid())
  game      String
  stake     Int
  status    String
  createdAt DateTime @default(now())

  hostId   String
  joinerId String?

  reportedWinnerId String?
  reportedById     String?

  host     User      @relation("HostedMatches", fields: [hostId], references: [id])
  joiner   User?     @relation("JoinedMatches", fields: [joinerId], references: [id])
  disputes Dispute[]
}

model Tournament {
  id              String    @id @default(uuid())
  name            String
  description     String?
  game            String
  entryFee        Int       @default(0)
  status          String    @default("upcoming")
  format          String    @default("single_elimination")
  hostId          String?
  teamSize        Int       @default(1)
  maxParticipants Int       @default(8)
  startAt         DateTime?
  createdAt       DateTime  @default(now())

  participants     TournamentEntry[]
  host             User?               @relation("TournamentHost", fields: [hostId], references: [id])
  teamParticipants TournamentTeam[]    @relation("teamParticipants")
  tMatches         TournamentMatch[]   @relation("tMatches")
}

model TournamentEntry {
  id           String   @id @default(uuid())
  tournamentId String
  userId       String
  joinedAt     DateTime @default(now())
  paid         Boolean  @default(false)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
}

model TournamentTeam {
  id           String   @id @default(uuid())
  tournamentId String
  teamId       String
  seed         Int?
  joinedAt     DateTime @default(now())
  wins         Int      @default(0)
  losses       Int      @default(0)
  scoreDiff    Int      @default(0)

  tournament  Tournament      @relation("teamParticipants", fields: [tournamentId], references: [id], onDelete: Cascade)
  team        Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  matchesAsA  TournamentMatch[] @relation("MatchTeamA")
  matchesAsB  TournamentMatch[] @relation("MatchTeamB")
  wonMatches  TournamentMatch[] @relation("MatchWinner")

  @@unique([tournamentId, teamId])
}

model TournamentMatch {
  id            String   @id @default(uuid())
  tournamentId  String
  roundNumber   Int
  matchIndex    Int
  teamAId       String?
  teamBId       String?
  winnerId      String?
  scoreA        Int?
  scoreB        Int?
  status        String   @default("pending")
  nextMatchId   String?
  nextMatchSlot String?
  createdAt     DateTime @default(now())

  tournament  Tournament                  @relation("tMatches", fields: [tournamentId], references: [id], onDelete: Cascade)
  teamA       TournamentTeam?             @relation("MatchTeamA", fields: [teamAId], references: [id])
  teamB       TournamentTeam?             @relation("MatchTeamB", fields: [teamBId], references: [id])
  winner      TournamentTeam?             @relation("MatchWinner", fields: [winnerId], references: [id])
  nextMatch   TournamentMatch?            @relation("MatchNext", fields: [nextMatchId], references: [id])
  prevMatches TournamentMatch[]           @relation("MatchNext")
  submissions TournamentMatchSubmission[]
}

model TournamentMatchSubmission {
  id             String   @id @default(uuid())
  matchId        String
  submittedBy    String
  submitterRole  String
  claimedWinnerId String
  scoreA         Int?
  scoreB         Int?
  createdAt      DateTime @default(now())

  match     TournamentMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  submitter User            @relation(fields: [submittedBy], references: [id])

  @@unique([matchId, submitterRole])
}

model Team {
  id          String   @id @default(uuid())
  name        String
  description String?
  game        String
  profileImageUrl String?
  ownerId     String
  createdAt   DateTime @default(now())

  owner   User            @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members TeamMember[]
  posts   TeamPost[]
  invites TeamInvite[]
  chat    TeamChat?
  tournamentTeams TournamentTeam[]
}

model TeamMember {
  id       String   @id @default(uuid())
  teamId   String
  userId   String
  role     TeamRole @default(colonel)
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model TeamPost {
  id        String   @id @default(uuid())
  teamId    String
  authorId  String
  title     String
  content   String
  createdAt DateTime @default(now())

  team   Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model TeamInvite {
  id         String           @id @default(uuid())
  teamId      String
  senderId    String
  receiverId  String
  status      TeamInviteStatus @default(pending)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  team     Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sender   User @relation("TeamInviteSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("TeamInviteReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([teamId, receiverId])
}

model TeamChat {
  id      String @id @default(uuid())
  teamId  String @unique
  chatId  String @unique

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String?
  channelId  String?
  content    String
  messageType String  @default("text")
  mediaUrl   String?
  replyToId  String?
  createdAt  DateTime @default(now())
  readAt     DateTime?
  editedAt   DateTime?

  sender   User      @relation("SentMessages", fields: [senderId], references: [id])
  receiver User?     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  replyTo  Message?  @relation("MessageReplies", fields: [replyToId], references: [id])
  replies  Message[] @relation("MessageReplies")
}

model Dispute {
  id          String   @id @default(uuid())
  matchId     String
  disputantId String
  evidence    String?
  reason      String?
  description String?
  status      String   @default("open")   // open | reviewing | resolved
  resolvedWinnerId String?
  resolvedAt  DateTime?
  resolvedByModId String?
  createdAt   DateTime @default(now())

  match     Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  disputant User  @relation(fields: [disputantId], references: [id], onDelete: Cascade)
  analysis  DisputeAnalysis?
  trainingData DisputeTrainingData?
}

model DisputeAnalysis {
  id                String   @id @default(uuid())
  disputeId         String   @unique
  suggestedWinnerId String?
  confidence        Float
  reasoning         String
  evidenceSummary   Json     // String[]
  rawResponse       Json?    // full OpenAI response for debugging
  createdAt         DateTime @default(now())

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
}

model DisputeTrainingData {
  id                String   @id @default(uuid())
  disputeId         String   @unique
  matchId           String
  playerAId         String
  playerBId         String
  submittedResults  Json     // { playerId, reportedWinnerId, submittedAt }[]
  finalWinnerId     String?
  disputeOutcome    String?  // approved_reporter | denied_reporter | split
  aiSuggestedWinnerId String?
  aiConfidence      Float?
  correctPrediction Boolean?
  resolvedAt        DateTime?
  createdAt         DateTime @default(now())

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
}

model PlatformConfig {
  id                   Int     @id @default(1) // single-row table
  siteName             String  @default("WannaBet?")
  maintenanceMode      Boolean @default(false)
  registrationEnabled  Boolean @default(true)
  trustScoreThreshold  Float   @default(0)
  minWagerAmount       Int     @default(5)
  maxWagerAmount       Int     @default(10000)
  maxActiveMatchesPerUser Int  @default(10)
  updatedAt            DateTime @updatedAt
}

model Ban {
  id          String    @id @default(uuid())
  userId      String
  moderatorId String
  reason      String?
  expiresAt   DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  user      User @relation("UserBans", fields: [userId], references: [id], onDelete: Cascade)
  moderator User @relation("ModeratorBans", fields: [moderatorId], references: [id], onDelete: Cascade)
}

model PlayerLog {
  id        String   @id @default(uuid())
  userId    String
  actorId   String? // who triggered the action (could be same user)
  type      String
  message   String?
  meta      Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Friend {
  id        String   @id @default(uuid())
  userId    String
  friendId  String
  createdAt DateTime @default(now())

  user   User @relation("UserFriends", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("UserFriendOf", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
}

model FriendRequest {
  id          String              @id @default(uuid())
  senderId    String
  recipientId String
  status      FriendRequestStatus @default(pending)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  sender    User @relation("SentFriendRequests", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("ReceivedFriendRequests", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([senderId, recipientId])
}

model BlockedUser {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlockedByUser", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockedTargetUser", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model Conversation {
  id           String   @id @default(uuid())
  key          String   @unique
  firstUserId  String
  secondUserId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  firstUser  User @relation("ConversationFirstUser", fields: [firstUserId], references: [id], onDelete: Cascade)
  secondUser User @relation("ConversationSecondUser", fields: [secondUserId], references: [id], onDelete: Cascade)

  @@unique([firstUserId, secondUserId])
}

model BugReport {
  id          String   @id @default(uuid())
  userId      String
  title       String
  category    String
  severity    String   // critical | high | medium | low
  description String
  steps       String?
  imageUrl    String?
  status      String   @default("open") // open | investigating | fixed | closed
  adminNote   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  PLAYER
  MODERATOR
  ADMIN
}

enum FriendRequestStatus {
  pending
  accepted
  declined
}

enum TeamRole {
  commander
  general
  colonel
}

enum TeamInviteStatus {
  pending
  accepted
  declined
}
