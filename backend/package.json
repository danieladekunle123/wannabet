{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "cd ../frontend && npm install && npm run build && rm -rf ../backend/public && cp -r build ../backend/public",
    "start": "ts-node --transpile-only src/index.ts",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:unit": "jest --runInBand --testPathPattern=tests/unit",
    "test:integration": "jest --runInBand --testPathPattern=tests/integration",
    "test:coverage": "jest --coverage",
    "test:e2e": "cd ../../e2e && npx playwright test"
  },
