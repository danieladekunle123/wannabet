    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "axios": "^1.13.5",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.73.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "google-auth-library": "^10.6.1",
    "ioredis": "^5.10.1",
    "jest": "^30.3.0",
    "jsonwebtoken": "^9.0.3",
